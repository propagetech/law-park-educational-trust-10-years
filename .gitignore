# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules

# Next.js
.next/
website/out/
build
dist
dist-ssr
*.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# secrets and large render artefacts
*.key
.elevenlabs_key
video/production/**/vo_eleven/
# No video is committed to this repository. Renders are reproducible from
# timeline.json plus the repo photographs (see tools/README.md), and the review
# cut streams from YouTube on team-handoff.html. Nothing here is a source asset.
*.mp4
*.mov
*.mkv
*.webm

# Regenerated by the render chain in anniversary-video-production/kannada/tools.
# Every one of these is reproducible from timeline.json plus the repo photographs,
# so none of it belongs in git. See tools/README.md.
video/production/**/tools/gfx/
video/production/**/tools/gfx@*x/
video/production/**/tools/stills/
video/production/**/tools/stills@*x/
video/production/**/tools/runway-plates/
video/production/**/tools/runway-plates@*x/
video/production/**/tools/vo/
video/production/**/tools/subs.json
video/production/**/tools/*.wav
video/production/**/tools/*.aiff

# Downloaded sound effects. The licence record is the CSV, not the files.
# The second pattern of each pair matters: the first only reaches direct
# children of sfx/, so a staging folder such as sfx/new/ would otherwise put
# tens of megabytes of audio into the repository.
video/production/**/tools/sfx/*.mp3
video/production/**/tools/sfx/**/*.mp3
video/production/**/tools/sfx/*.wav
video/production/**/tools/sfx/**/*.wav
video/production/**/tools/sfx/*.ogg
video/production/**/tools/sfx/**/*.ogg
video/production/**/tools/sfx/*.flac
video/production/**/tools/sfx/**/*.flac
video/production/**/tools/sfx/*.m4a
video/production/**/tools/sfx/**/*.m4a

# Download staging area. Everything needed from it has been copied to sfx/ and
# sfx/licence-evidence/, which ARE the record. Safe to delete once verified.
video/production/**/tools/sfx/new/
video/production/**/tools/vo_eleven/

# Audio deliverables from tools/mix.py: stems, masters and previews. All of it
# is rebuilt from timeline.json plus the narration stem and sfx/placements.csv,
# and the cue sheet and licence log beside the pack are the record of what is in
# them. `tools/*.wav` above does not reach a subdirectory, so it is named here.
video/production/**/tools/mix/

# Local env (never commit API keys)
.env
.env.*
!.env.example

# ElevenLabs Kannada voice pipeline artefacts
video/production/kannada-voice/audition-audio/
video/production/kannada-voice/final-narration/
video/production/kannada-voice/manifests/narration-generation-log.csv
# Per-run derived plans and measurements. Rewritten by every invocation, so they
# churn in every diff. The stable reports beside them are the record: the
# shortlist, scorecard, recommendation and pronunciation notes.
video/production/kannada-voice/reports/audition-plan.json
video/production/kannada-voice/reports/audition-measurements.json
video/production/kannada-voice/reports/final-narration-plan.json

# Python build artefacts. These were tracked before and churn on every edit
# to a tool, which puts noise in unrelated diffs.
__pycache__/
*.pyc

# The creative-team asset drop, staged by scripts/build-asset-drop.sh and
# uploaded to the GitHub release that team-handoff.html links to. Every file in
# it is a copy of something already tracked, or a zip of them, so it rebuilds
# in seconds and committing it would only duplicate the pack.
video/.asset-drop/

