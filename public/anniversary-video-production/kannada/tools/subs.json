[{"start": 7.0, "end": 10.434, "lines": ["ಪ್ರತಿ ವರ್ಷ, ಕರ್ನಾಟಕದ", "ಹಳ್ಳಿಗಳಲ್ಲಿ, ಮಕ್ಕಳು ತಮ್ಮ"]}, {"start": 10.434, "end": 14.44, "lines": ["ಬಳಿ ಇರುವುದೆಲ್ಲವನ್ನೂ ಒಂದೇ", "ಚೀಲದಲ್ಲಿ ಹೊತ್ತು ಶಾಲೆಗೆ ನಡೆಯುತ್ತಾರೆ."]}, {"start": 14.44, "end": 17.24, "lines": ["ಅವರಿಗೆ ಬುದ್ಧಿ ಇದೆ. ಕಲಿಯುವ ಹಂಬಲ ಇದೆ."]}, {"start": 18.24, "end": 23.84, "lines": ["ಆದರೆ ಆ ನಡಿಗೆಗೂ ತರಗತಿಗೂ ನಡುವೆ, ಶಾಲಾ", "ಶುಲ್ಕ ಒಂದು ತೀರ್ಮಾನ ತೆಗೆದುಕೊಂಡು ಬಿಡುತ್ತದೆ."]}, {"start": 25.84, "end": 29.92, "lines": ["ಹತ್ತು ವರ್ಷಗಳಿಂದ, ಒಂದು ಟ್ರಸ್ಟ್", "ಸರಿಯಾಗಿ ಅಲ್ಲಿಯೇ ಬಂದು ನಿಂತಿದೆ."]}, {"start": 36.42, "end": 39.5, "lines": ["ಲಾ ಪಾರ್ಕ್ ಎಜುಕೇಷನಲ್ ಟ್ರಸ್ಟ್, ಬೆಂಗಳೂರಿನ"]}, {"start": 39.5, "end": 42.58, "lines": ["ಎಚ್.ಎಸ್.ಆರ್. ಲೇಔಟ್‌ನಲ್ಲಿರುವ", "ನೋಂದಾಯಿತ ಶೈಕ್ಷಣಿಕ ಟ್ರಸ್ಟ್."]}, {"start": 42.58, "end": 44.603, "lines": ["ಇದನ್ನು ಸ್ಥಾಪಿಸಿದವರು ಚಾರುಲತಾ ಎಂ. ಆರ್."]}, {"start": 44.603, "end": 52.02, "lines": ["ಟ್ರಸ್ಟ್ ಶುರುವಾಗುವ ಮೊದಲೇ ಅವರು ತಮ್ಮ ಬಡಾವಣೆಯ", "ಮಕ್ಕಳ ಶಾಲಾ ಶುಲ್ಕವನ್ನು ತಾವೇ ಕಟ್ಟುತ್ತಿದ್ದರು."]}, {"start": 52.02, "end": 54.432, "lines": ["ಅವರ ಜೊತೆಗೂಡಿದವರು ಸಾದೇನಹಳ್ಳಿಯ ಎಸ್. ಎಂ. ಮಂಜುನಾಥ."]}, {"start": 54.432, "end": 59.86, "lines": ["ಓದಲೆಂದು ಊರು ಬಿಟ್ಟು ನಗರಕ್ಕೆ ಬಂದ", "ತಮ್ಮ ಕುಟುಂಬದ ಮೊದಲ ವ್ಯಕ್ತಿ."]}, {"start": 59.86, "end": 63.3, "lines": ["ತಮ್ಮ ಊರಿನ ಹಲವು ಮಕ್ಕಳನ್ನು", "ಅವರು ಆಗಲೇ ಓದಿಸಿದ್ದರು."]}, {"start": 65.3, "end": 69.06, "lines": ["2016ರಲ್ಲಿ ಅವರು ಮೊದಲ ಶಾಲಾ ಭೇಟಿ ಮಾಡಿದರು."]}, {"start": 69.06, "end": 71.42, "lines": ["ಚಿಕ್ಕಬಳ್ಳಾಪುರ. ಒಂದು ಮಗು."]}, {"start": 71.42, "end": 73.22, "lines": ["ಒಂದು ವಿದ್ಯಾರ್ಥಿವೇತನ."]}, {"start": 74.22, "end": 79.66, "lines": ["ಅದೇ ಭೇಟಿಯಲ್ಲಿ ನೂರೈವತ್ತು ವಿದ್ಯಾರ್ಥಿಗಳಿಗೆ", "ಸ್ಟೀಲ್ ತಟ್ಟೆ ಮತ್ತು ಲೋಟ ವಿತರಿಸಲಾಯಿತು."]}, {"start": 79.66, "end": 82.62, "lines": ["2017ರಲ್ಲಿ ಒಂದು ಹತ್ತಾಯಿತು."]}, {"start": 82.62, "end": 85.58, "lines": ["ಹತ್ತು ವಿದ್ಯಾರ್ಥಿಗಳಿಗೆ ವಿದ್ಯಾರ್ಥಿವೇತನ."]}, {"start": 85.58, "end": 88.057, "lines": ["ಆಮೇಲೆ ಕೆಲಸ ಹಾಗೇ ಮುಂದುವರಿಯಿತು."]}, {"start": 88.057, "end": 89.857, "lines": ["ವರ್ಷದಿಂದ ವರ್ಷಕ್ಕೆ."]}, {"start": 89.857, "end": 93.42, "lines": ["ಅದೇ ದಾರಿಗಳು, ಅದೇ ಶಾಲೆಗಳು, ಇನ್ನಷ್ಟು ಮಕ್ಕಳು."]}, {"start": 95.42, "end": 100.3, "lines": ["2020ರಲ್ಲಿ ಶಾಲೆಗಳು ಮುಚ್ಚಿದವು,", "ಕುಟುಂಬಗಳ ದಿನಗೂಲಿ ನಿಂತಿತು."]}, {"start": 100.3, "end": 104.426, "lines": ["ಆಗ ಟ್ರಸ್ಟ್ ಒಂದೇ ಪುಟದ ಪ್ರಕಟಣೆ ಹೊರಡಿಸಿತು."]}, {"start": 104.426, "end": 106.558, "lines": ["ಪೋಷಕರನ್ನು ಕಳೆದುಕೊಂಡ ಮಕ್ಕಳಿಗೆ."]}, {"start": 106.558, "end": 110.02, "lines": ["ಕೆಲಸ ಕಳೆದುಕೊಂಡು ಶುಲ್ಕ ಕಟ್ಟಲಾಗದ ಪೋಷಕರಿಗೆ."]}, {"start": 110.02, "end": 111.82, "lines": ["ನೆರವು ನಿಲ್ಲಲಿಲ್ಲ."]}, {"start": 112.82, "end": 116.706, "lines": ["2022ರಲ್ಲಿ ಪುಸ್ತಕದ ಕಪಾಟುಗಳು ಎದ್ದವು."]}, {"start": 116.706, "end": 119.62, "lines": ["ಗ್ರಾಮೀಣ ಶಾಲೆಗಳಲ್ಲಿ ಗ್ರಂಥಾಲಯಗಳು."]}, {"start": 119.62, "end": 124.9, "lines": ["ದಾನವಾಗಿ ಬಂದ ಕಥೆ ಪುಸ್ತಕಗಳು, ಪಠ್ಯ", "ಪುಸ್ತಕಗಳು, ಬಳಸದೇ ಉಳಿದ ನೋಟ್‌ಬುಕ್‌ಗಳು."]}, {"start": 124.9, "end": 127.214, "lines": ["2023ರಲ್ಲಿ ವ್ಯಾಪ್ತಿ ಹಿಗ್ಗಿತು."]}, {"start": 127.214, "end": 129.014, "lines": ["ಮೈಸೂರು."]}, {"start": 129.014, "end": 130.9, "lines": ["ಎಚ್.ಡಿ. ಕೋಟೆ."]}, {"start": 130.9, "end": 135.337, "lines": ["ಒಂಬತ್ತು ಮತ್ತು ಹತ್ತನೇ ತರಗತಿಯ", "ಮಕ್ಕಳಿಗೆ ವೃತ್ತಿ ಮಾರ್ಗದರ್ಶನ."]}, {"start": 135.337, "end": 139.14, "lines": ["ಬದುಕಿನ ದಾರಿ ಸದ್ದಿಲ್ಲದೆ ನಿರ್ಧಾರವಾಗುವ ವಯಸ್ಸು ಅದು."]}, {"start": 139.14, "end": 144.217, "lines": ["2024ರಲ್ಲಿ ಎಂ.ಎಂ. ಹಿಲ್ಸ್‌ನ", "ಬುಡಕಟ್ಟು ಶಾಲೆಗಳಲ್ಲಿ ಇನ್ನೂರು ಶಾಲಾ"]}, {"start": 144.217, "end": 150.02, "lines": ["ಚೀಲ, ನೋಟ್‌ಬುಕ್ ಮತ್ತು ಲೇಖನ ಸಾಮಗ್ರಿಗಳೊಂದಿಗೆ", "ಶೈಕ್ಷಣಿಕ ವರ್ಷ ಆರಂಭವಾಯಿತು."]}, {"start": 150.02, "end": 154.5, "lines": ["ಮತ್ತು 2025ರಲ್ಲಿ, ಎಚ್.ಡಿ. ಕೋಟೆಯಲ್ಲಿ, ಮುನ್ನೂರು."]}, {"start": 157.0, "end": 159.64, "lines": ["ಇದೆಲ್ಲ ಕಚೇರಿಯಲ್ಲಿ ಕುಳಿತು ಆಗುವ ಕೆಲಸವಲ್ಲ."]}, {"start": 159.64, "end": 164.52, "lines": ["ಮುಖ್ಯೋಪಾಧ್ಯಾಯರೋ, ನೆರೆಹೊರೆಯವರೋ, ಊರಿನ", "ಹಿತೈಷಿಯೋ ಒಂದು ಹೆಸರು ಸೂಚಿಸುತ್ತಾರೆ."]}, {"start": 164.52, "end": 166.809, "lines": ["ತಂಡ ಆ ಊರಿಗೆ ಹೋಗುತ್ತದೆ."]}, {"start": 166.809, "end": 171.96, "lines": ["ಮಕ್ಕಳನ್ನೂ ಪೋಷಕರನ್ನೂ ಒಂದೆಡೆ ಸೇರಿಸಿ,", "ಪ್ರತಿ ಕುಟುಂಬದ ಜೊತೆ ಕೂತು ಮಾತನಾಡುತ್ತದೆ."]}, {"start": 172.96, "end": 176.6, "lines": ["ನಂತರ ಟ್ರಸ್ಟ್ ಶಾಲಾ ಶುಲ್ಕದ ಶೇಕಡ", "ಎಪ್ಪತ್ತೈದರಷ್ಟನ್ನು ಭರಿಸುತ್ತದೆ."]}, {"start": 176.6, "end": 178.4, "lines": ["ಪೂರ್ತಿ ಅಲ್ಲ."]}, {"start": 180.4, "end": 182.571, "lines": ["ಉಳಿದ ಪಾಲನ್ನು ಕುಟುಂಬವೇ ಕಟ್ಟುತ್ತದೆ."]}, {"start": 182.571, "end": 188.0, "lines": ["ಏಕೆಂದರೆ ತಾವೂ ಒಂದು ಪಾಲು ಹೊತ್ತ ಪೋಷಕರು", "ಮಗುವಿನ ಓದಿನ ಒಳಗೇ ಉಳಿಯುತ್ತಾರೆ."]}, {"start": 188.0, "end": 190.976, "lines": ["ಮತ್ತು ಆ ಹಣ ನೇರವಾಗಿ ಶಾಲೆಗೇ ಸಲ್ಲುತ್ತದೆ."]}, {"start": 190.976, "end": 192.96, "lines": ["ಬೇರೆ ಯಾರ ಕೈಗೂ ಅಲ್ಲ."]}, {"start": 192.96, "end": 197.254, "lines": ["ಬುಡಕಟ್ಟು ಶಾಲೆಗಳ ಮಕ್ಕಳ ಜೊತೆ", "ತಂಡ ಕೆಲವು ದಿನ ಉಳಿಯುತ್ತದೆ."]}, {"start": 197.254, "end": 199.054, "lines": ["ಕಲಿಸುತ್ತದೆ, ಕಲಿಯುತ್ತದೆ."]}, {"start": 199.054, "end": 201.84, "lines": ["ಆಮೇಲೆ ಚೀಲಗಳು ಮಕ್ಕಳ ಕೈ ಸೇರುತ್ತವೆ."]}, {"start": 201.84, "end": 204.933, "lines": ["ವಿದ್ಯಾರ್ಥಿವೇತನ ಒಂದರಿಂದಲೇ ಶಿಕ್ಷಣ ಪೂರ್ಣವಾಗುವುದಿಲ್ಲ."]}, {"start": 204.933, "end": 211.12, "lines": ["ಹಾಗಾಗಿ ಶಾಲಾ ಚೀಲ, ನೋಟ್‌ಬುಕ್, ಲೇಖನ", "ಸಾಮಗ್ರಿ, ಚಿತ್ರಕಲೆಯ ಪರಿಕರ."]}, {"start": 211.12, "end": 212.92, "lines": ["ಗ್ರಂಥಾಲಯಗಳು."]}, {"start": 212.92, "end": 214.72, "lines": ["ವೃತ್ತಿ ಮಾರ್ಗದರ್ಶನ."]}, {"start": 214.72, "end": 216.52, "lines": ["ಆಟಗಳು."]}, {"start": 216.52, "end": 220.0, "lines": ["ಮಕ್ಕಳು ಹಾಡಿ ಕುಣಿಯುವ ವೇದಿಕೆ,", "ಮತ್ತು ಅದನ್ನು ನೋಡಲೆಂದೇ ಬಂದ ಜನ."]}, {"start": 220.0, "end": 223.28, "lines": ["ಮಕ್ಕಳಿಗೆ ಮಾತ್ರವಲ್ಲ, ಪೋಷಕರಿಗೂ ಮಾರ್ಗದರ್ಶನ."]}, {"start": 223.28, "end": 227.227, "lines": ["ತಲುಪುವುದೇ ಕಷ್ಟವಾದ ಮಕ್ಕಳನ್ನೂ ಈ ಕೆಲಸ ತಲುಪಿದೆ."]}, {"start": 227.227, "end": 229.2, "lines": ["ಏಕ ಪೋಷಕರ ಮಕ್ಕಳು."]}, {"start": 229.2, "end": 231.831, "lines": ["ಎಚ್‌ಐವಿ ಇರುವ ಕುಟುಂಬಗಳ ಮಕ್ಕಳು."]}, {"start": 231.831, "end": 235.12, "lines": ["ದೀರ್ಘಕಾಲದ ಆರೋಗ್ಯ ಸಮಸ್ಯೆ ಇರುವ ಮಕ್ಕಳು."]}, {"start": 236.12, "end": 240.429, "lines": ["ಈ ಕೆಲಸ ಬೆಳಕು ಟ್ರಸ್ಟ್,", "ಸೌಖ್ಯ ಸಮೃದ್ಧಿ ಸಂಸ್ಥೆ, ಜಿಲ್ಲಾ"]}, {"start": 240.429, "end": 244.2, "lines": ["ಆರೋಗ್ಯ ಇಲಾಖೆ ಮತ್ತು ನಿಸರ್ಗ", "ಫೌಂಡೇಶನ್ ಜೊತೆಗೂಡಿ ನಡೆದಿದೆ."]}, {"start": 244.2, "end": 250.502, "lines": ["2024ರ ಜೂನ್‌ನಲ್ಲಿ ಒಂದು ಕನ್ನಡ ದಿನಪತ್ರಿಕೆ", "ಮುಳಬಾಗಿಲಿನ ಚಿತ್ರವನ್ನು ಪ್ರಕಟಿಸಿತು."]}, {"start": 250.502, "end": 254.44, "lines": ["ಏಕ ಪೋಷಕರ ಮಕ್ಕಳಿಗೆ ವಿದ್ಯಾರ್ಥಿವೇತನ ವಿತರಣೆ."]}, {"start": 255.44, "end": 258.582, "lines": ["2025ರ ಡಿಸೆಂಬರ್‌ನಲ್ಲಿ, ನವದೆಹಲಿಯ ರಾಷ್ಟ್ರೀಯ"]}, {"start": 258.582, "end": 264.08, "lines": ["ಶೃಂಗಸಭೆಯಲ್ಲಿ, ಸಂಸ್ಥಾಪಕರಿಗೆ ಭಾರತ್", "ಶಿಕ್ಷಾ ರತ್ನ ಪ್ರಶಸ್ತಿ ಸಂದಿತು."]}, {"start": 266.08, "end": 270.526, "lines": ["ಆದರೆ ಮುಖ್ಯವಾದ ದಾಖಲೆ ಪ್ರಶಸ್ತಿ ಪತ್ರದಲ್ಲಿ ಇಲ್ಲ."]}, {"start": 270.526, "end": 273.491, "lines": ["ಅದು ಒಂದು ಹೆಸರುಗಳ ಪಟ್ಟಿಯಲ್ಲಿದೆ."]}, {"start": 273.491, "end": 280.16, "lines": ["ಬೆಂಗಳೂರು, ಚೆನ್ನೈ, ಅಮೆರಿಕ, ಬ್ರಿಟನ್, ಜರ್ಮನಿ,", "ಡೆನ್ಮಾರ್ಕ್, ದುಬೈನಲ್ಲಿದ್ದು ನೆರವು ನೀಡಿದವರು."]}, {"start": 280.16, "end": 284.916, "lines": ["ವಕೀಲರು, ಎಂಜಿನಿಯರ್‌ಗಳು, ವೈದ್ಯರು,", "ಗೃಹಿಣಿಯರು ಆಗಿರುವ ಸ್ವಯಂಸೇವಕರು."]}, {"start": 284.916, "end": 288.88, "lines": ["ಒಂದು ಮಗುವಿಗಾಗಿ ಫೋನ್ ಮಾಡಿದ ಶಿಕ್ಷಕರು."]}, {"start": 288.88, "end": 291.76, "lines": ["ಮತ್ತು ತಮ್ಮ ಪಾಲನ್ನು ತಪ್ಪದೇ ಕಟ್ಟಿದ ಪೋಷಕರು."]}, {"start": 291.76, "end": 297.613, "lines": ["ಈ ವರ್ಷ, ತನ್ನ ಆರೈಕೆಯಲ್ಲಿರುವ ಎಲ್ಲ ಮಕ್ಕಳನ್ನೂ", "ಬೆಂಗಳೂರಿಗೆ ಕರೆತರಬೇಕೆಂಬುದು ಟ್ರಸ್ಟ್‌ನ ಆಸೆ."]}, {"start": 297.613, "end": 302.88, "lines": ["ಒಂದು ಕಾರ್ಯಕ್ರಮ, ಒಂದು ದಿನದ", "ಸುತ್ತಾಟ, ಮನೆಗೆ ಒಯ್ಯಲು ಒಂದು ಉಡುಗೊರೆ."]}, {"start": 302.88, "end": 306.72, "lines": ["ಅವರಲ್ಲಿ ಹಲವರಿಗೆ ಇದು ಈ", "ನಗರವನ್ನು ನೋಡುವ ಮೊದಲ ಬಾರಿ."]}, {"start": 306.72, "end": 310.08, "lines": ["ಕೆಲವರಿಗೆ ತಮ್ಮ ಊರು ಬಿಟ್ಟು ಹೊರಡುವ ಮೊದಲ ಬಾರಿ."]}, {"start": 311.08, "end": 313.24, "lines": ["ಮುಂದಿನ ಹತ್ತು ವರ್ಷವೂ ಹೀಗೇ."]}, {"start": 313.24, "end": 315.04, "lines": ["ಇನ್ನಷ್ಟು ಜಿಲ್ಲೆಗಳು."]}, {"start": 315.04, "end": 316.84, "lines": ["ಇನ್ನಷ್ಟು ಗ್ರಂಥಾಲಯಗಳು."]}, {"start": 316.84, "end": 319.0, "lines": ["ಓದು ನಿಲ್ಲದ ಇನ್ನಷ್ಟು ಮಕ್ಕಳು."]}, {"start": 319.0, "end": 321.56, "lines": ["ಹತ್ತು ವರ್ಷ. ಒಂದೊಂದೇ ಮಗು."]}, {"start": 321.56, "end": 324.12, "lines": ["ಸದ್ದಿಲ್ಲದೆ ಉಳಿಸಿಕೊಂಡ ಒಂದು ಮಾತು."]}, {"start": 325.12, "end": 330.88, "lines": ["ಲಾ ಪಾರ್ಕ್ ಎಜುಕೇಷನಲ್ ಟ್ರಸ್ಟ್‌ನ ಹತ್ತನೇ ವರ್ಷದ", "ಸಂಭ್ರಮಕ್ಕೆ ನಿಮಗೆಲ್ಲರಿಗೂ ಆತ್ಮೀಯ ಸ್ವಾಗತ."]}]