[{"start": 7.0, "end": 10.988, "lines": ["ಪ್ರತಿ ವರ್ಷ, ಕರ್ನಾಟಕದ", "ಹಳ್ಳಿಗಳಲ್ಲಿ, ಮಕ್ಕಳು ತಮ್ಮ"]}, {"start": 10.988, "end": 15.64, "lines": ["ಬಳಿ ಇರುವುದೆಲ್ಲವನ್ನೂ ಒಂದೇ", "ಚೀಲದಲ್ಲಿ ಹೊತ್ತು ಶಾಲೆಗೆ ನಡೆಯುತ್ತಾರೆ."]}, {"start": 15.64, "end": 18.84, "lines": ["ಅವರಿಗೆ ಬುದ್ಧಿ ಇದೆ. ಕಲಿಯುವ ಹಂಬಲ ಇದೆ."]}, {"start": 19.84, "end": 26.0, "lines": ["ಆದರೆ ಆ ನಡಿಗೆಗೂ ತರಗತಿಗೂ ನಡುವೆ, ಶಾಲಾ", "ಶುಲ್ಕ ಒಂದು ತೀರ್ಮಾನ ತೆಗೆದುಕೊಂಡು ಬಿಡುತ್ತದೆ."]}, {"start": 28.0, "end": 32.48, "lines": ["ಹತ್ತು ವರ್ಷಗಳಿಂದ, ಒಂದು ಟ್ರಸ್ಟ್", "ಸರಿಯಾಗಿ ಅಲ್ಲಿಯೇ ಬಂದು ನಿಂತಿದೆ."]}, {"start": 38.98, "end": 42.46, "lines": ["ಲಾ ಪಾರ್ಕ್ ಎಜುಕೇಷನಲ್ ಟ್ರಸ್ಟ್, ಬೆಂಗಳೂರಿನ"]}, {"start": 42.46, "end": 45.94, "lines": ["ಎಚ್.ಎಸ್.ಆರ್. ಲೇಔಟ್‌ನಲ್ಲಿರುವ", "ನೋಂದಾಯಿತ ಶೈಕ್ಷಣಿಕ ಟ್ರಸ್ಟ್."]}, {"start": 45.94, "end": 48.117, "lines": ["ಇದನ್ನು ಸ್ಥಾಪಿಸಿದವರು ಚಾರುಲತಾ ಎಂ. ಆರ್."]}, {"start": 48.117, "end": 56.1, "lines": ["ಟ್ರಸ್ಟ್ ಶುರುವಾಗುವ ಮೊದಲೇ ಅವರು ತಮ್ಮ ಬಡಾವಣೆಯ", "ಮಕ್ಕಳ ಶಾಲಾ ಶುಲ್ಕವನ್ನು ತಾವೇ ಕಟ್ಟುತ್ತಿದ್ದರು."]}, {"start": 56.1, "end": 58.758, "lines": ["ಅವರ ಜೊತೆಗೂಡಿದವರು ಸಾದೇನಹಳ್ಳಿಯ ಎಸ್. ಎಂ. ಮಂಜುನಾಥ."]}, {"start": 58.758, "end": 64.74, "lines": ["ಓದಲೆಂದು ಊರು ಬಿಟ್ಟು ನಗರಕ್ಕೆ ಬಂದ", "ತಮ್ಮ ಕುಟುಂಬದ ಮೊದಲ ವ್ಯಕ್ತಿ."]}, {"start": 64.74, "end": 68.34, "lines": ["ತಮ್ಮ ಊರಿನ ಹಲವು ಮಕ್ಕಳನ್ನು", "ಅವರು ಆಗಲೇ ಓದಿಸಿದ್ದರು."]}, {"start": 70.34, "end": 74.34, "lines": ["2016ರಲ್ಲಿ ಅವರು ಮೊದಲ ಶಾಲಾ ಭೇಟಿ ಮಾಡಿದರು."]}, {"start": 74.34, "end": 77.412, "lines": ["ಚಿಕ್ಕಬಳ್ಳಾಪುರ. ಒಂದು ಮಗು."]}, {"start": 77.412, "end": 79.46, "lines": ["ಒಂದು ವಿದ್ಯಾರ್ಥಿವೇತನ."]}, {"start": 80.46, "end": 85.98, "lines": ["ಅದೇ ಭೇಟಿಯಲ್ಲಿ ನೂರೈವತ್ತು ವಿದ್ಯಾರ್ಥಿಗಳಿಗೆ", "ಸ್ಟೀಲ್ ತಟ್ಟೆ ಮತ್ತು ಲೋಟ ವಿತರಿಸಲಾಯಿತು."]}, {"start": 85.98, "end": 89.02, "lines": ["2017ರಲ್ಲಿ ಒಂದು ಹತ್ತಾಯಿತು."]}, {"start": 89.02, "end": 92.06, "lines": ["ಹತ್ತು ವಿದ್ಯಾರ್ಥಿಗಳಿಗೆ ವಿದ್ಯಾರ್ಥಿವೇತನ."]}, {"start": 92.06, "end": 94.508, "lines": ["ಆಮೇಲೆ ಕೆಲಸ ಹಾಗೇ ಮುಂದುವರಿಯಿತು."]}, {"start": 94.508, "end": 96.308, "lines": ["ವರ್ಷದಿಂದ ವರ್ಷಕ್ಕೆ."]}, {"start": 96.308, "end": 99.82, "lines": ["ಅದೇ ದಾರಿಗಳು, ಅದೇ ಶಾಲೆಗಳು, ಇನ್ನಷ್ಟು ಮಕ್ಕಳು."]}, {"start": 101.82, "end": 107.82, "lines": ["2020ರಲ್ಲಿ ಶಾಲೆಗಳು ಮುಚ್ಚಿದವು,", "ಕುಟುಂಬಗಳ ದಿನಗೂಲಿ ನಿಂತಿತು."]}, {"start": 107.82, "end": 112.233, "lines": ["ಆಗ ಟ್ರಸ್ಟ್ ಒಂದೇ ಪುಟದ ಪ್ರಕಟಣೆ ಹೊರಡಿಸಿತು."]}, {"start": 112.233, "end": 114.487, "lines": ["ಪೋಷಕರನ್ನು ಕಳೆದುಕೊಂಡ ಮಕ್ಕಳಿಗೆ."]}, {"start": 114.487, "end": 118.18, "lines": ["ಕೆಲಸ ಕಳೆದುಕೊಂಡು ಶುಲ್ಕ ಕಟ್ಟಲಾಗದ ಪೋಷಕರಿಗೆ."]}, {"start": 118.18, "end": 119.98, "lines": ["ನೆರವು ನಿಲ್ಲಲಿಲ್ಲ."]}, {"start": 120.98, "end": 125.094, "lines": ["2022ರಲ್ಲಿ ಪುಸ್ತಕದ ಕಪಾಟುಗಳು ಎದ್ದವು."]}, {"start": 125.094, "end": 128.18, "lines": ["ಗ್ರಾಮೀಣ ಶಾಲೆಗಳಲ್ಲಿ ಗ್ರಂಥಾಲಯಗಳು."]}, {"start": 128.18, "end": 133.78, "lines": ["ದಾನವಾಗಿ ಬಂದ ಕಥೆ ಪುಸ್ತಕಗಳು, ಪಠ್ಯ", "ಪುಸ್ತಕಗಳು, ಬಳಸದೇ ಉಳಿದ ನೋಟ್‌ಬುಕ್‌ಗಳು."]}, {"start": 133.78, "end": 136.273, "lines": ["2023ರಲ್ಲಿ ವ್ಯಾಪ್ತಿ ಹಿಗ್ಗಿತು."]}, {"start": 136.273, "end": 138.073, "lines": ["ಮೈಸೂರು."]}, {"start": 138.073, "end": 140.02, "lines": ["ಎಚ್.ಡಿ. ಕೋಟೆ."]}, {"start": 140.02, "end": 144.586, "lines": ["ಒಂಬತ್ತು ಮತ್ತು ಹತ್ತನೇ ತರಗತಿಯ", "ಮಕ್ಕಳಿಗೆ ವೃತ್ತಿ ಮಾರ್ಗದರ್ಶನ."]}, {"start": 144.586, "end": 148.5, "lines": ["ಬದುಕಿನ ದಾರಿ ಸದ್ದಿಲ್ಲದೆ ನಿರ್ಧಾರವಾಗುವ ವಯಸ್ಸು ಅದು."]}, {"start": 148.5, "end": 153.652, "lines": ["2024ರಲ್ಲಿ ಎಂ.ಎಂ. ಹಿಲ್ಸ್‌ನ", "ಬುಡಕಟ್ಟು ಶಾಲೆಗಳಲ್ಲಿ ಇನ್ನೂರು ಶಾಲಾ"]}, {"start": 153.652, "end": 159.54, "lines": ["ಚೀಲ, ನೋಟ್‌ಬುಕ್ ಮತ್ತು ಲೇಖನ ಸಾಮಗ್ರಿಗಳೊಂದಿಗೆ", "ಶೈಕ್ಷಣಿಕ ವರ್ಷ ಆರಂಭವಾಯಿತು."]}, {"start": 159.54, "end": 164.1, "lines": ["ಮತ್ತು 2025ರಲ್ಲಿ, ಎಚ್.ಡಿ. ಕೋಟೆಯಲ್ಲಿ, ಮುನ್ನೂರು."]}, {"start": 166.6, "end": 169.8, "lines": ["ಇದೆಲ್ಲ ಕಚೇರಿಯಲ್ಲಿ ಕುಳಿತು ಆಗುವ ಕೆಲಸವಲ್ಲ."]}, {"start": 169.8, "end": 176.28, "lines": ["ಮುಖ್ಯೋಪಾಧ್ಯಾಯರೋ, ನೆರೆಹೊರೆಯವರೋ, ಊರಿನ", "ಹಿತೈಷಿಯೋ ಒಂದು ಹೆಸರು ಸೂಚಿಸುತ್ತಾರೆ."]}, {"start": 176.28, "end": 178.742, "lines": ["ತಂಡ ಆ ಊರಿಗೆ ಹೋಗುತ್ತದೆ."]}, {"start": 178.742, "end": 184.28, "lines": ["ಮಕ್ಕಳನ್ನೂ ಪೋಷಕರನ್ನೂ ಒಂದೆಡೆ ಸೇರಿಸಿ,", "ಪ್ರತಿ ಕುಟುಂಬದ ಜೊತೆ ಕೂತು ಮಾತನಾಡುತ್ತದೆ."]}, {"start": 185.28, "end": 189.4, "lines": ["ನಂತರ ಟ್ರಸ್ಟ್ ಶಾಲಾ ಶುಲ್ಕದ ಶೇಕಡ", "ಎಪ್ಪತ್ತೈದರಷ್ಟನ್ನು ಭರಿಸುತ್ತದೆ."]}, {"start": 189.4, "end": 191.2, "lines": ["ಪೂರ್ತಿ ಅಲ್ಲ."]}, {"start": 193.2, "end": 195.486, "lines": ["ಉಳಿದ ಪಾಲನ್ನು ಕುಟುಂಬವೇ ಕಟ್ಟುತ್ತದೆ."]}, {"start": 195.486, "end": 201.2, "lines": ["ಏಕೆಂದರೆ ತಾವೂ ಒಂದು ಪಾಲು ಹೊತ್ತ ಪೋಷಕರು", "ಮಗುವಿನ ಓದಿನ ಒಳಗೇ ಉಳಿಯುತ್ತಾರೆ."]}, {"start": 201.2, "end": 204.368, "lines": ["ಮತ್ತು ಆ ಹಣ ನೇರವಾಗಿ ಶಾಲೆಗೇ ಸಲ್ಲುತ್ತದೆ."]}, {"start": 204.368, "end": 206.48, "lines": ["ಬೇರೆ ಯಾರ ಕೈಗೂ ಅಲ್ಲ."]}, {"start": 206.48, "end": 211.234, "lines": ["ಬುಡಕಟ್ಟು ಶಾಲೆಗಳ ಮಕ್ಕಳ ಜೊತೆ", "ತಂಡ ಕೆಲವು ದಿನ ಉಳಿಯುತ್ತದೆ."]}, {"start": 211.234, "end": 213.034, "lines": ["ಕಲಿಸುತ್ತದೆ, ಕಲಿಯುತ್ತದೆ."]}, {"start": 213.034, "end": 216.08, "lines": ["ಆಮೇಲೆ ಚೀಲಗಳು ಮಕ್ಕಳ ಕೈ ಸೇರುತ್ತವೆ."]}, {"start": 216.08, "end": 219.227, "lines": ["ವಿದ್ಯಾರ್ಥಿವೇತನ ಒಂದರಿಂದಲೇ ಶಿಕ್ಷಣ ಪೂರ್ಣವಾಗುವುದಿಲ್ಲ."]}, {"start": 219.227, "end": 225.52, "lines": ["ಹಾಗಾಗಿ ಶಾಲಾ ಚೀಲ, ನೋಟ್‌ಬುಕ್, ಲೇಖನ", "ಸಾಮಗ್ರಿ, ಚಿತ್ರಕಲೆಯ ಪರಿಕರ."]}, {"start": 225.52, "end": 227.32, "lines": ["ಗ್ರಂಥಾಲಯಗಳು."]}, {"start": 227.32, "end": 229.12, "lines": ["ವೃತ್ತಿ ಮಾರ್ಗದರ್ಶನ."]}, {"start": 229.12, "end": 230.92, "lines": ["ಆಟಗಳು."]}, {"start": 230.92, "end": 234.72, "lines": ["ಮಕ್ಕಳು ಹಾಡಿ ಕುಣಿಯುವ ವೇದಿಕೆ,", "ಮತ್ತು ಅದನ್ನು ನೋಡಲೆಂದೇ ಬಂದ ಜನ."]}, {"start": 234.72, "end": 237.92, "lines": ["ಮಕ್ಕಳಿಗೆ ಮಾತ್ರವಲ್ಲ, ಪೋಷಕರಿಗೂ ಮಾರ್ಗದರ್ಶನ."]}, {"start": 237.92, "end": 241.76, "lines": ["ತಲುಪುವುದೇ ಕಷ್ಟವಾದ ಮಕ್ಕಳನ್ನೂ ಈ ಕೆಲಸ ತಲುಪಿದೆ."]}, {"start": 241.76, "end": 243.68, "lines": ["ಏಕ ಪೋಷಕರ ಮಕ್ಕಳು."]}, {"start": 243.68, "end": 246.24, "lines": ["ಎಚ್‌ಐವಿ ಇರುವ ಕುಟುಂಬಗಳ ಮಕ್ಕಳು."]}, {"start": 246.24, "end": 249.44, "lines": ["ದೀರ್ಘಕಾಲದ ಆರೋಗ್ಯ ಸಮಸ್ಯೆ ಇರುವ ಮಕ್ಕಳು."]}, {"start": 250.44, "end": 254.792, "lines": ["ಈ ಕೆಲಸ ಬೆಳಕು ಟ್ರಸ್ಟ್,", "ಸೌಖ್ಯ ಸಮೃದ್ಧಿ ಸಂಸ್ಥೆ, ಜಿಲ್ಲಾ"]}, {"start": 254.792, "end": 258.6, "lines": ["ಆರೋಗ್ಯ ಇಲಾಖೆ ಮತ್ತು ನಿಸರ್ಗ", "ಫೌಂಡೇಶನ್ ಜೊತೆಗೂಡಿ ನಡೆದಿದೆ."]}, {"start": 258.6, "end": 265.542, "lines": ["2024ರ ಜೂನ್‌ನಲ್ಲಿ ಒಂದು ಕನ್ನಡ ದಿನಪತ್ರಿಕೆ", "ಮುಳಬಾಗಿಲಿನ ಚಿತ್ರವನ್ನು ಪ್ರಕಟಿಸಿತು."]}, {"start": 265.542, "end": 269.88, "lines": ["ಏಕ ಪೋಷಕರ ಮಕ್ಕಳಿಗೆ ವಿದ್ಯಾರ್ಥಿವೇತನ ವಿತರಣೆ."]}, {"start": 270.88, "end": 274.284, "lines": ["2025ರ ಡಿಸೆಂಬರ್‌ನಲ್ಲಿ, ನವದೆಹಲಿಯ ರಾಷ್ಟ್ರೀಯ"]}, {"start": 274.284, "end": 280.24, "lines": ["ಶೃಂಗಸಭೆಯಲ್ಲಿ, ಸಂಸ್ಥಾಪಕರಿಗೆ ಭಾರತ್", "ಶಿಕ್ಷಾ ರತ್ನ ಪ್ರಶಸ್ತಿ ಸಂದಿತು."]}, {"start": 282.24, "end": 287.065, "lines": ["ಆದರೆ ಮುಖ್ಯವಾದ ದಾಖಲೆ ಪ್ರಶಸ್ತಿ ಪತ್ರದಲ್ಲಿ ಇಲ್ಲ."]}, {"start": 287.065, "end": 290.282, "lines": ["ಅದು ಒಂದು ಹೆಸರುಗಳ ಪಟ್ಟಿಯಲ್ಲಿದೆ."]}, {"start": 290.282, "end": 297.52, "lines": ["ಬೆಂಗಳೂರು, ಚೆನ್ನೈ, ಅಮೆರಿಕ, ಬ್ರಿಟನ್, ಜರ್ಮನಿ,", "ಡೆನ್ಮಾರ್ಕ್, ದುಬೈನಲ್ಲಿದ್ದು ನೆರವು ನೀಡಿದವರು."]}, {"start": 297.52, "end": 302.407, "lines": ["ವಕೀಲರು, ಎಂಜಿನಿಯರ್‌ಗಳು, ವೈದ್ಯರು,", "ಗೃಹಿಣಿಯರು ಆಗಿರುವ ಸ್ವಯಂಸೇವಕರು."]}, {"start": 302.407, "end": 306.48, "lines": ["ಒಂದು ಮಗುವಿಗಾಗಿ ಫೋನ್ ಮಾಡಿದ ಶಿಕ್ಷಕರು."]}, {"start": 306.48, "end": 309.28, "lines": ["ಮತ್ತು ತಮ್ಮ ಪಾಲನ್ನು ತಪ್ಪದೇ ಕಟ್ಟಿದ ಪೋಷಕರು."]}, {"start": 309.28, "end": 315.469, "lines": ["ಈ ವರ್ಷ, ತನ್ನ ಆರೈಕೆಯಲ್ಲಿರುವ ಎಲ್ಲ ಮಕ್ಕಳನ್ನೂ", "ಬೆಂಗಳೂರಿಗೆ ಕರೆತರಬೇಕೆಂಬುದು ಟ್ರಸ್ಟ್‌ನ ಆಸೆ."]}, {"start": 315.469, "end": 321.04, "lines": ["ಒಂದು ಕಾರ್ಯಕ್ರಮ, ಒಂದು ದಿನದ", "ಸುತ್ತಾಟ, ಮನೆಗೆ ಒಯ್ಯಲು ಒಂದು ಉಡುಗೊರೆ."]}, {"start": 321.04, "end": 325.179, "lines": ["ಅವರಲ್ಲಿ ಹಲವರಿಗೆ ಇದು ಈ", "ನಗರವನ್ನು ನೋಡುವ ಮೊದಲ ಬಾರಿ."]}, {"start": 325.179, "end": 328.8, "lines": ["ಕೆಲವರಿಗೆ ತಮ್ಮ ಊರು ಬಿಟ್ಟು ಹೊರಡುವ ಮೊದಲ ಬಾರಿ."]}, {"start": 329.8, "end": 332.24, "lines": ["ಮುಂದಿನ ಹತ್ತು ವರ್ಷವೂ ಹೀಗೇ."]}, {"start": 332.24, "end": 334.04, "lines": ["ಇನ್ನಷ್ಟು ಜಿಲ್ಲೆಗಳು."]}, {"start": 334.04, "end": 335.84, "lines": ["ಇನ್ನಷ್ಟು ಗ್ರಂಥಾಲಯಗಳು."]}, {"start": 335.84, "end": 338.28, "lines": ["ಓದು ನಿಲ್ಲದ ಇನ್ನಷ್ಟು ಮಕ್ಕಳು."]}, {"start": 338.28, "end": 340.08, "lines": ["ಹತ್ತು ವರ್ಷ."]}, {"start": 340.08, "end": 341.88, "lines": ["ಒಂದೊಂದೇ ಮಗು."]}, {"start": 341.88, "end": 344.2, "lines": ["ಸದ್ದಿಲ್ಲದೆ ಉಳಿಸಿಕೊಂಡ ಒಂದು ಮಾತು."]}, {"start": 345.2, "end": 350.88, "lines": ["ಲಾ ಪಾರ್ಕ್ ಎಜುಕೇಷನಲ್ ಟ್ರಸ್ಟ್‌ನ ಹತ್ತನೇ ವರ್ಷದ", "ಸಂಭ್ರಮಕ್ಕೆ ನಿಮಗೆಲ್ಲರಿಗೂ ಆತ್ಮೀಯ ಸ್ವಾಗತ."]}]